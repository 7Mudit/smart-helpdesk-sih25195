{
  "name": "smart-helpdesk",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Helpdesk Ticketing Solution for IT Services — SIH25195, Ministry of Power",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/set-db-provider.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "setup": "node scripts/ensure-env.mjs && node scripts/set-db-provider.mjs && prisma generate && prisma db push --skip-generate && tsx prisma/seed.ts",
    "db:push": "node scripts/set-db-provider.mjs && prisma db push",
    "db:seed": "node scripts/set-db-provider.mjs && prisma generate && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "rm -f prisma/dev.db && npm run setup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "predev": "node scripts/ensure-env.mjs && node scripts/set-db-provider.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "^15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.25",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
