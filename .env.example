# Copy is NOT required — `npm run setup` creates .env for you with a freshly
# generated JWT_SECRET. This file documents the variables only.

DATABASE_URL="file:./dev.db"

# Must be a random 32+ character string, unique per deployment.
# The app refuses to start with a placeholder value, because a secret that is
# committed to a repository is public — anyone could forge a session with it.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Optional: when set, /api/cron/sla-sweep requires this in an x-cron-secret
# header. Leave unset locally; set it in production.
# CRON_SECRET=""
